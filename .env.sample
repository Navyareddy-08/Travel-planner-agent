# Runtime mode
# offline = deterministic classroom demo without an API key
# live = real Groq calls
DEMO_MODE=offline

# Groq â€” required only when DEMO_MODE=live
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1

# LangSmith â€” optional tracing for live mode
# LangSmith uses LANGSMITH_* variables in current SDK versions.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=ls__your-key-here
LANGSMITH_PROJECT=BIA_Mini_Project_Sprint_Travel_Planner

